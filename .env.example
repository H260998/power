APP_NAME="ALO E-SHOP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.tld

# One-time browser installer at /setup. Use a random value of 32+ characters.
# Example generator: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
SETUP_TOKEN=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Supabase on Vercel: use pgsql and the Session pooler URL (port 5432).
# Create the private schema with database/supabase-bootstrap.sql first.
# DB_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
# DB_SCHEMA=laravel
# DB_SSLMODE=require

# Optional CLI seeder fallback when the browser installer is not used.
ADMIN_EMAIL=admin@your-domain.tld
ADMIN_PASSWORD=change-me-before-deploying

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Set to vercel-blob on Vercel; the connected Blob store provides its token.
UPLOADS_DRIVER=local
BLOB_READ_WRITE_TOKEN=
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@your-domain.tld"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
